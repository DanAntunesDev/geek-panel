{
  "name": "geek-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Painel local para display remoto compacto",
  "main": "dist-electron/main/app.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && electron-builder --dir",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.geekpanel.app",
    "productName": "Painel local",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**",
      "dist-electron/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/pixel/icon-512.png",
      "category": "Utility",
      "desktop": {
        "entry": {
          "StartupWMClass": "com.geekpanel.app"
        }
      }
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
